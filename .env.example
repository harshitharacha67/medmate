# Copy this file to .env and fill in what you need. Everything is optional.
PORT=3000

# Optional: unlocks the full voice assistant (understands any language),
# prescription photo scanning and smarter replies. Without it, MedMate uses a
# built-in assistant that understands English, Hindi, Telugu, Tamil, Spanish,
# French and German keywords.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
